# --- Datasets -------------------------------------------------------------
# Raw source files. Re-downloadable from the pinned HuggingFace revision
# listed in the project brief, and far too large for version control.
*.csv

# Derived tables produced by ali-01-EDA.ipynb. Regenerable in ~3 minutes by
# re-running that notebook, so they are outputs, not source.
*.parquet

# --- Derived artefacts ----------------------------------------------------
# Embeddings, vector indexes, LLM response caches. Large and reproducible.
artifacts/

# --- Credentials ----------------------------------------------------------
# The Gemini API key belongs in a local .env file that is never committed.
.env
.env.*
!.env.example
*.key
secrets.json

# --- Local model downloads ------------------------------------------------
models/
.cache/
hf_cache/

# --- Python / Jupyter housekeeping ---------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Office lock files ----------------------------------------------------
# PowerPoint/Word create these while a document is open.
~$*
